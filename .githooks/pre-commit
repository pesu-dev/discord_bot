#!/bin/bash

# Get the repository root directory
REPO_ROOT="$(git rev-parse --show-toplevel)"

# Source utilities
source "$REPO_ROOT/.githooks/utils.sh"

print_info "🚀 Running pre-commit checks..."
echo

# Run quality checks (blocking)
if ! run_quality_checks; then
    print_error "Quality checks failed. Commit aborted."
    exit 1
fi
echo

# Verify cog packages import cleanly (blocking)
if ! run_cog_import_checks; then
    print_error "Cog import checks failed. Commit aborted."
    exit 1
fi
echo

# Fast unit suite only (integration needs Docker; runs in CI)
if ! run_unit_tests; then
    print_error "Unit tests failed. Commit aborted."
    exit 1
fi
echo

print_success "🎉 All pre-commit checks passed!"
exit 0
