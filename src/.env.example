BOT_TOKEN=""
# Path to the Atlas X.509 client certificate (.pem).
# Defaults to scratch/mongo-dev.pem when unset.
# MONGO_X509_CERT_PATH=""
# Optional; one of: prod, dev, local. Defaults to local when unset.
# Unless you know what you are doing, keep it as local.
# APP_ENV="local"
# Atlas service account credentials for each project (OAuth client credentials).
# These are optional; if not set, you will not be able to use the /eng mongo commands.
# ATLAS_DEV_CLIENT_ID=""
# ATLAS_DEV_CLIENT_SECRET=""
# ATLAS_PROD_CLIENT_ID=""
# ATLAS_PROD_CLIENT_SECRET=""
